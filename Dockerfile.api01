FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source

COPY NuGet.Config ./
COPY src/ClearlySaid.Shared/ClearlySaid.Shared.csproj src/ClearlySaid.Shared/
COPY src/ClearlySaid.Api/ClearlySaid.Api.csproj src/ClearlySaid.Api/
RUN dotnet restore src/ClearlySaid.Api/ClearlySaid.Api.csproj --configfile NuGet.Config

COPY src/ClearlySaid.Shared/ src/ClearlySaid.Shared/
COPY src/ClearlySaid.Api/ src/ClearlySaid.Api/
RUN dotnet publish src/ClearlySaid.Api/ClearlySaid.Api.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "ClearlySaid.Api.dll"]
