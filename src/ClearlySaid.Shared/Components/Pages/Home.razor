@page "/"
@implements IDisposable
@inject IMessageRefinementService RefinementService
@inject IAccountService AccountService
@inject IBillingService BillingService
@inject IDictationService DictationService
@inject IServiceProvider Services
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>ClearlySaid</PageTitle>

@if (showSecurityNotice && AccountService.CurrentAccount is not null)
{
    <div class="cs-modal-backdrop" role="presentation">
        <section class="cs-security-modal" role="dialog" aria-modal="true" aria-labelledby="security-notice-heading" aria-describedby="security-notice-copy">
            <span class="cs-security-icon" aria-hidden="true">🔒</span>
            <h2 id="security-notice-heading">Confidentiality and security notice</h2>
            <div id="security-notice-copy">
                <p>ClearlySaid encrypts your message while it travels between your device and our services. Your text is processed only to create the rewrite you requested.</p>
                <p>ClearlySaid does not save your original message or rewritten response in its account or usage database. The response is returned only to your signed-in session. We retain limited usage metadata, such as your account, processing time, message size, provider, latency, and outcome, but not the message or rewritten text.</p>
                <p>If our private processing service definitely fails, your message may be sent to OpenAI as a fallback, as described in our Privacy Policy.</p>
                <p><strong>Do not submit passwords, financial account information, protected health information, regulated data, or confidential information you are not authorized to share.</strong> ClearlySaid is not a records repository and is not represented as HIPAA compliant. HIPAA-regulated use requires a separate written agreement and appropriate compliance review.</p>
            </div>
            <label class="cs-security-choice"><input type="checkbox" @bind="doNotShowSecurityNoticeAgain" /> Don't display again</label>
            @if (!string.IsNullOrWhiteSpace(securityNoticeError))
            {
                <p class="cs-error" role="alert">@securityNoticeError</p>
            }
            <div class="cs-security-actions">
                <a href="/privacy">Read Privacy Policy</a>
                <button class="cs-button cs-button-primary" type="button" disabled="@securityNoticeBusy" @onclick="CloseSecurityNoticeAsync">I understand</button>
            </div>
        </section>
    </div>
}

<main class="cs-page">
    <header class="cs-brand">
        <div>
            <h1>ClearlySaid</h1>
            <p>Say it naturally. Send it clearly.</p>
        </div>
        @if (AccountService.CurrentAccount is { } currentAccount)
        {
            <details class="cs-account-menu">
                <summary aria-label="Open account menu for @currentAccount.Email">
                    <span aria-hidden="true">@AccountInitial</span>
                </summary>
                <div class="cs-account-menu-panel">
                    <strong>@currentAccount.Email</strong>
                    @if (currentAccount.IsUnlimited)
                    {
                        <small>Administrator, unlimited messages</small>
                    }
                    else
                    {
                        <small>@currentAccount.Remaining of @currentAccount.MonthlyAllowance messages remaining</small>
                    }
                    <a href="/account/profile">Profile</a>
                    @if (currentAccount.Role == AccountRoles.Admin)
                    {
                        <a href="/admin">Admin console</a>
                    }
                    else
                    {
                        <a href="#plans">Plans and billing</a>
                    }
                    <button class="cs-link-button" type="button" @onclick="LogoutAsync">Sign out</button>
                </div>
            </details>
        }
    </header>

    @if (!AccountService.IsInitialized)
    {
        <section class="cs-account"><p>Loading your accountâ€¦</p></section>
    }
    else if (AccountService.CurrentAccount is null)
    {
        <section class="cs-account" aria-labelledby="account-heading">
            <h2 id="account-heading">@(showRegistration ? "Create your account" : "Sign in")</h2>
            <p>Your account protects the service and keeps track of your monthly allowance.</p>
            <form @onsubmit="SubmitAccountAsync" @onsubmit:preventDefault>
                <label for="account-email">Email</label>
                <input id="account-email" type="email" autocomplete="email" @bind="email" />
                <label for="account-password">Password</label>
                <div class="cs-password-field">
                    <input id="account-password"
                           type="@(showPassword ? "text" : "password")"
                           autocomplete="@(showRegistration ? "new-password" : "current-password")"
                           @bind="password" />
                    <button type="button"
                            class="cs-password-toggle"
                            aria-label="@(showPassword ? "Hide password" : "Show password")"
                            aria-pressed="@showPassword"
                            title="@(showPassword ? "Hide password" : "Show password")"
                            @onclick="TogglePasswordVisibility">
                        @if (showPassword)
                        {
                            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 3l18 18M10.6 10.7a2 2 0 002.7 2.7M9.9 4.2A10.9 10.9 0 0112 4c5.5 0 9 5 9 5a15 15 0 01-2.1 2.5M6.6 6.6C4.3 8.1 3 10 3 10s3.5 5 9 5a10.8 10.8 0 004.2-.8" /></svg>
                        }
                        else
                        {
                            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 12s3.5-5 9-5 9 5 9 5-3.5 5-9 5-9-5-9-5z" /><circle cx="12" cy="12" r="2.5" /></svg>
                        }
                    </button>
                </div>
                @if (showRegistration)
                {
                    <small>Use at least 12 characters with uppercase, lowercase, and a number.</small>
                }
                <button class="cs-button cs-button-primary" type="submit" disabled="@isAccountBusy">
                    @(isAccountBusy ? "Please waitâ€¦" : showRegistration ? "Create account" : "Sign in")
                </button>
            </form>
            <button class="cs-link-button" type="button" @onclick="ToggleAccountMode">
                @(showRegistration ? "Already have an account? Sign in" : "New to ClearlySaid? Create an account")
            </button>
            @if (!showRegistration)
            {
                <button class="cs-link-button" type="button" @onclick="RequestPasswordResetAsync">Forgot password?</button>
            }
            @if (!string.IsNullOrWhiteSpace(accountNotice))
            {
                <p class="cs-billing-notice" role="status">@accountNotice</p>
            }
        </section>
    }

    @if (AccountService.CurrentAccount is { Role: not AccountRoles.Admin } account)
    {
        <section id="plans" class="cs-billing" aria-labelledby="billing-heading">
            <div class="cs-billing-heading">
                <div>
                    <h2 id="billing-heading">Plans and billing</h2>
                    <p>Choose the allowance that fits how often you use ClearlySaid.</p>
                </div>
                <div class="cs-billing-tools">
                    <button class="cs-link-button" type="button" disabled="@isBillingBusy" @onclick="RefreshPlanAsync">
                        Refresh plan
                    </button>
                    @if (BillingService.IsAvailable &&
                         (string.Equals(account.SubscriptionProvider, "stripe", StringComparison.OrdinalIgnoreCase) ||
                          string.Equals(account.SubscriptionProvider, "google", StringComparison.OrdinalIgnoreCase)))
                    {
                        <button class="cs-link-button" type="button" disabled="@isBillingBusy" @onclick="ManageBillingAsync">
                            Manage billing
                        </button>
                        @if (string.Equals(account.SubscriptionProvider, "stripe", StringComparison.OrdinalIgnoreCase))
                        {
                            <button class="cs-link-button" type="button" disabled="@isBillingBusy" @onclick="CancelBillingAsync">Cancel subscription</button>
                        }
                    }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(billingNotice))
            {
                <p class="cs-billing-notice" role="status">@billingNotice</p>
            }

            @if (!string.IsNullOrWhiteSpace(BillingService.AvailabilityMessage))
            {
                <p class="cs-billing-notice" role="status">@BillingService.AvailabilityMessage</p>
            }

            @if (account.Plan == SubscriptionPlans.Free)
            {
                <div class="cs-plan-grid">
                    @foreach (var plan in SubscriptionPlans.All.Where(candidate => candidate.IsPurchasable))
                    {
                        <article class="cs-plan-card">
                            <h3>@plan.DisplayName</h3>
                            <strong>@plan.MonthlyAllowance.ToString("N0") messages / month</strong>
                            <p>@plan.Description</p>
                            <div class="cs-plan-actions">
                                <button class="cs-button cs-button-primary" type="button"
                                        disabled="@(isBillingBusy || !BillingService.IsAvailable)"
                                        @onclick="() => StartCheckoutAsync(plan.Id, BillingIntervals.Monthly)">
                                    @CheckoutLabel(plan.MonthlyPrice, "month")
                                </button>
                                <button class="cs-button cs-button-secondary" type="button"
                                        disabled="@(isBillingBusy || !BillingService.IsAvailable)"
                                        @onclick="() => StartCheckoutAsync(plan.Id, BillingIntervals.Annual)">
                                    @CheckoutLabel(plan.AnnualPrice, "year")
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
            else if (!string.Equals(account.SubscriptionProvider, "stripe", StringComparison.OrdinalIgnoreCase))
            {
                <p class="cs-billing-notice">Your subscription is managed by @ProviderName(account.SubscriptionProvider).</p>
            }
        </section>
    }

    @if (AccountService.CurrentAccount is { IsUnlimited: false, Remaining: 0 })
    {
        <section class="cs-limit-callout" role="status" aria-labelledby="limit-heading">
            <h2 id="limit-heading">Your messages will reset soon</h2>
            <p>You have used this month’s allowance. Choose a plan above for more message improvements, or return after your allowance resets.</p>
            <a class="cs-button cs-button-primary" href="#plans">Compare plans</a>
        </section>
    }

    @if (string.IsNullOrWhiteSpace(result))
    {
    <section class="cs-compose" aria-labelledby="your-words-heading" aria-disabled="@(AccountService.CurrentAccount is null || IsOutOfMessages)">
        <div class="cs-compose-heading">
            <h2 id="your-words-heading">Your words</h2>
            @if (isListening)
            {
                <span class="cs-listening" role="status">Listening…</span>
            }
        </div>

        <label class="cs-sr-only" for="message-input">Your dictated or typed message</label>
        <textarea id="message-input"
                  maxlength="5000"
                  spellcheck="true"
                  autocorrect="on"
                  autocapitalize="sentences"
                  disabled="@(AccountService.CurrentAccount is null || IsOutOfMessages)"
                  placeholder="Tap the microphone and start speaking, or type here…"
                  @bind="message"
                  @bind:event="oninput"></textarea>

        @if (HasMessageStyleControls)
        {
            <details class="cs-style-controls">
                <summary>Message style <span>Paid feature</span></summary>
                <div class="cs-style-content">
                <p>Optionally shape the rewrite without changing your facts.</p>
                <div class="cs-style-grid">
                    <label>
                        Purpose
                        <select @bind="selectedPurpose">
                            @foreach (var option in MessageStyleCatalog.Purposes)
                            {
                                <option value="@option.Id">@option.Label</option>
                            }
                        </select>
                    </label>
                    <label>
                        Tone
                        <select @bind="selectedTone">
                            @foreach (var option in MessageStyleCatalog.Tones)
                            {
                                <option value="@option.Id">@option.Label</option>
                            }
                        </select>
                    </label>
                    <label>
                        Directness
                        <select @bind="selectedDirectness">
                            @foreach (var option in MessageStyleCatalog.DirectnessLevels)
                            {
                                <option value="@option.Id">@option.Label</option>
                            }
                        </select>
                    </label>
                </div>
                </div>
            </details>
        }

        <div class="cs-actions">
            <button class="cs-button cs-button-secondary"
                    type="button"
                    disabled="@(isBusy || AccountService.CurrentAccount is null || IsOutOfMessages)"
                    @onclick="ToggleDictationAsync">
                <span aria-hidden="true">@(isListening ? "■" : "🎙")</span>
                @(isListening ? "Stop" : "Dictate")
            </button>
            <button class="cs-button cs-button-secondary"
                    type="button"
                    aria-label="Clear dictated and suggested text"
                    disabled="@(!CanClear)"
                    @onclick="ClearAsync">
                Clear
            </button>
            <button class="cs-button cs-button-primary"
                    type="button"
                    disabled="@(isBusy || AccountService.CurrentAccount is null || IsOutOfMessages)"
                    @onclick="RefineAsync">
                @(isBusy ? "Improving…" : "Make it clear")
            </button>
        </div>
    </section>
    }
    else
    {
        <section class="cs-result" aria-live="polite" aria-labelledby="clear-version-heading">
            <h2 id="clear-version-heading">ClearlySaid response</h2>
            <p>@result</p>
            <div class="cs-result-actions">
                <button class="cs-button cs-button-copy" type="button" @onclick="CopyAsync">
                    @(copied ? "Copied" : "Copy message")
                </button>
                <button class="cs-button cs-button-result-secondary" type="button" @onclick="EditWords">Edit your words</button>
                <button class="cs-button cs-button-result-secondary" type="button" @onclick="ClearAsync">New message</button>
            </div>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="cs-error" role="alert">@errorMessage</p>
    }
</main>

@code {
    private string message = string.Empty;
    private string result = string.Empty;
    private string errorMessage = string.Empty;
    private bool isListening;
    private bool isBusy;
    private bool copied;
    private bool showRegistration;
    private bool showPassword;
    private bool isAccountBusy;
    private bool isBillingBusy;
    private bool showSecurityNotice;
    private bool doNotShowSecurityNoticeAgain;
    private bool securityNoticeBusy;
    private string securityNoticeError = string.Empty;
    private string billingNotice = string.Empty;
    private string email = string.Empty;
    private string accountNotice = string.Empty;
    private string password = string.Empty;
    private string selectedPurpose = MessageStyleCatalog.PreservePurpose;
    private string selectedTone = MessageStyleCatalog.PreserveTone;
    private string selectedDirectness = MessageStyleCatalog.BalancedDirectness;
    private CancellationTokenSource? operationCancellation;
    private CancellationTokenSource? copyResetCancellation;
    private bool IsOutOfMessages => AccountService.CurrentAccount is
        { IsUnlimited: false, Remaining: 0 };
    private bool CanClear =>
        isListening || isBusy ||
        !string.IsNullOrWhiteSpace(message) ||
        !string.IsNullOrWhiteSpace(result) ||
        !string.IsNullOrWhiteSpace(errorMessage);
    private bool HasMessageStyleControls => AccountService.CurrentAccount is { } account &&
        (account.IsUnlimited || account.Plan != SubscriptionPlans.Free);
    private string AccountInitial => AccountService.CurrentAccount?.Email
        .FirstOrDefault(char.IsLetterOrDigit).ToString().ToUpperInvariant() ?? "A";

    protected override void OnInitialized()
    {
        DictationService.TranscriptChanged += OnTranscriptChanged;
        DictationService.ListeningStopped += OnListeningStopped;
        DictationService.Error += OnDictationError;
        AccountService.AccountChanged += OnAccountChanged;
        AccountService.LoginSucceeded += OnLoginSucceeded;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await AccountService.InitializeAsync();
            if (BillingService.IsAvailable)
            {
                var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query;
                if (query.Contains("billing=success", StringComparison.OrdinalIgnoreCase))
                {
                    await AccountService.RefreshAsync();
                    billingNotice = "Payment received. Your plan will update as soon as Stripe confirms the subscription.";
                }
                else if (query.Contains("billing=canceled", StringComparison.OrdinalIgnoreCase))
                {
                    billingNotice = "Checkout was canceled. Your current plan has not changed.";
                }
            }
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }

        StateHasChanged();
    }

    private async Task SubmitAccountAsync()
    {
        try
        {
            isAccountBusy = true;
            errorMessage = string.Empty;
            if (showRegistration)
            {
                accountNotice = await AccountService.RegisterAsync(email, password);
                if (Services.GetService(typeof(IRegistrationSuccessTracker)) is IRegistrationSuccessTracker tracker)
                {
                    await tracker.TrackAsync();
                }
                showRegistration = false;
                password = string.Empty;
            }
            else
            {
                await AccountService.LoginAsync(email, password);
            }

            password = string.Empty;
            showPassword = false;
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isAccountBusy = false;
        }
    }

    private async Task RequestPasswordResetAsync()
    {
        if (string.IsNullOrWhiteSpace(email)) { accountNotice = "Enter your email address first."; return; }
        await AccountService.RequestPasswordResetAsync(email);
        accountNotice = "If that account exists, a password-reset link is on its way.";
    }

    private void ToggleAccountMode()
    {
        showRegistration = !showRegistration;
        password = string.Empty;
        showPassword = false;
        errorMessage = string.Empty;
    }

    private void TogglePasswordVisibility() => showPassword = !showPassword;

    private async Task LogoutAsync()
    {
        await AccountService.LogoutAsync();
        result = string.Empty;
    }

    private async Task StartCheckoutAsync(string plan, string interval)
    {
        await RunBillingAsync(() => BillingService.StartCheckoutAsync(plan, interval));
    }

    private async Task ManageBillingAsync()
    {
        await RunBillingAsync(() => BillingService.ManageBillingAsync());
    }

    private async Task CancelBillingAsync()
    {
        await RunBillingAsync(async () =>
        {
            var result = await BillingService.CancelSubscriptionAsync();
            billingNotice = result.AccessEndsAt is null ? result.Message : $"{result.Message} Paid access continues through {result.AccessEndsAt:MMMM d, yyyy}.";
        });
    }

    private async Task RefreshPlanAsync()
    {
        try
        {
            isBillingBusy = true;
            errorMessage = string.Empty;
            await AccountService.RefreshAsync();
            billingNotice = "Your subscription status is up to date.";
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isBillingBusy = false;
        }
    }

    private async Task RunBillingAsync(Func<Task> action)
    {
        try
        {
            isBillingBusy = true;
            errorMessage = string.Empty;
            billingNotice = string.Empty;
            await action();
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isBillingBusy = false;
        }
    }

    private static string ProviderName(string? provider) => provider?.ToLowerInvariant() switch
    {
        "google" => "Google Play",
        "apple" => "the Apple App Store",
        "admin" => "ClearlySaid support",
        _ => "your app store"
    };

    private string CheckoutLabel(decimal price, string period) => BillingService.CheckoutMode switch
    {
        BillingCheckoutMode.ExternalWebsite => $"Continue on website · ${price:0.00}/{period}",
        BillingCheckoutMode.Unavailable => "Purchases coming soon",
        _ => $"${price:0.00}/{period}"
    };

    private void OnAccountChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnLoginSucceeded(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            showSecurityNotice = AccountService.CurrentAccount is { SecurityNoticeDismissed: false };
            doNotShowSecurityNoticeAgain = false;
            securityNoticeError = string.Empty;
            StateHasChanged();
        });
    }

    private async Task CloseSecurityNoticeAsync()
    {
        try
        {
            securityNoticeBusy = true;
            securityNoticeError = string.Empty;
            await AccountService.AcknowledgeSecurityNoticeAsync(doNotShowSecurityNoticeAgain);

            showSecurityNotice = false;
        }
        catch (Exception exception)
        {
            securityNoticeError = exception.Message;
        }
        finally
        {
            securityNoticeBusy = false;
        }
    }

    private async Task ToggleDictationAsync()
    {
        errorMessage = string.Empty;

        if (!DictationService.IsSupported)
        {
            errorMessage = "Speech recognition isn't available on this device or browser.";
            return;
        }

        try
        {
            if (isListening)
            {
                await DictationService.StopAsync();
            }
            else
            {
                result = string.Empty;
                await DictationService.StartAsync();
                isListening = true;
            }
        }
        catch (Exception exception)
        {
            isListening = false;
            errorMessage = $"Dictation couldn't start: {exception.Message}";
        }
    }

    private async Task RefineAsync()
    {
        if (IsOutOfMessages)
        {
            errorMessage = "You have reached this month’s message allowance. Choose a plan or wait for the allowance to reset.";
            return;
        }

        if (string.IsNullOrWhiteSpace(message))
        {
            errorMessage = "Dictate or type a message first.";
            return;
        }

        operationCancellation?.Cancel();
        operationCancellation?.Dispose();
        var requestCancellation = new CancellationTokenSource(TimeSpan.FromSeconds(30));
        operationCancellation = requestCancellation;

        try
        {
            isBusy = true;
            copyResetCancellation?.Cancel();
            copyResetCancellation?.Dispose();
            copyResetCancellation = null;
            copied = false;
            errorMessage = string.Empty;
            result = string.Empty;
            var style = HasMessageStyleControls
                ? new MessageStyleOptions(selectedPurpose, selectedTone, selectedDirectness)
                : null;
            result = await RefinementService.RefineAsync(
                message.Trim(),
                style,
                requestCancellation.Token);
        }
        catch (OperationCanceledException) when (!ReferenceEquals(operationCancellation, requestCancellation))
        {
            // The user cleared the screen while this request was running.
        }
        catch (OperationCanceledException)
        {
            errorMessage = "ClearlySaid took longer than expected. Please submit your message again.";
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            if (ReferenceEquals(operationCancellation, requestCancellation))
            {
                operationCancellation = null;
                requestCancellation.Dispose();
                isBusy = false;
            }
        }
    }

    private async Task ClearAsync()
    {
        var activeCancellation = operationCancellation;
        operationCancellation = null;
        activeCancellation?.Cancel();
        activeCancellation?.Dispose();
        copyResetCancellation?.Cancel();
        copyResetCancellation?.Dispose();
        copyResetCancellation = null;

        try
        {
            if (isListening || DictationService.IsListening)
            {
                await DictationService.StopAsync();
            }
        }
        catch
        {
            // Clearing should still succeed if speech recognition has already stopped.
        }

        isListening = false;
        isBusy = false;
        message = string.Empty;
        result = string.Empty;
        errorMessage = string.Empty;
        copied = false;
    }

    private void EditWords()
    {
        copyResetCancellation?.Cancel();
        copyResetCancellation?.Dispose();
        copyResetCancellation = null;
        result = string.Empty;
        copied = false;
        errorMessage = string.Empty;
    }

    private async Task CopyAsync()
    {
        await JS.InvokeVoidAsync("clearlySaid.copyText", result);

        copyResetCancellation?.Cancel();
        copyResetCancellation?.Dispose();
        var resetCancellation = new CancellationTokenSource();
        copyResetCancellation = resetCancellation;
        copied = true;
        _ = ResetCopyStatusAsync(resetCancellation);
    }

    private async Task ResetCopyStatusAsync(CancellationTokenSource resetCancellation)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(5), resetCancellation.Token);
            if (!ReferenceEquals(copyResetCancellation, resetCancellation))
            {
                return;
            }

            await InvokeAsync(() =>
            {
                copied = false;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
            // A later copy, clear, or component disposal superseded this reset.
        }
    }

    private void OnTranscriptChanged(object? sender, string transcript)
    {
        _ = InvokeAsync(() =>
        {
            message = transcript;
            StateHasChanged();
        });
    }

    private void OnListeningStopped(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            isListening = false;
            StateHasChanged();
        });
    }

    private void OnDictationError(object? sender, string error)
    {
        _ = InvokeAsync(() =>
        {
            isListening = false;
            errorMessage = error;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        operationCancellation?.Cancel();
        operationCancellation?.Dispose();
        copyResetCancellation?.Cancel();
        copyResetCancellation?.Dispose();
        DictationService.TranscriptChanged -= OnTranscriptChanged;
        DictationService.ListeningStopped -= OnListeningStopped;
        DictationService.Error -= OnDictationError;
        AccountService.AccountChanged -= OnAccountChanged;
        AccountService.LoginSucceeded -= OnLoginSucceeded;
    }
}
