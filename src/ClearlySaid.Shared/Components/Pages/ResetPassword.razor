@page "/reset-password"
@inject IAccountService AccountService
@inject NavigationManager Navigation

<PageTitle>Reset password - ClearlySaid</PageTitle>
<main class="cs-page"><section class="cs-account"><h1>Reset your password</h1>
<label>New password</label><input type="password" autocomplete="new-password" @bind="password" />
<small>Use at least 12 characters with uppercase, lowercase, and a number.</small>
<button class="cs-button cs-button-primary" disabled="@busy" @onclick="ResetAsync">Reset password</button>
<p role="status">@message</p></section></main>

@code {
    private string password = "", message = ""; private bool busy;
    private async Task ResetAsync()
    {
        busy = true;
        var token = Uri.UnescapeDataString(new Uri(Navigation.Uri).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault(part => part.StartsWith("token=", StringComparison.OrdinalIgnoreCase))?.Split('=', 2).ElementAtOrDefault(1) ?? "");
        try { await AccountService.ResetPasswordAsync(token, password); message = "Password reset. You may now return to the sign-in page."; }
        catch (AccountApiException ex) { message = ex.Message; }
        finally { busy = false; }
    }
}
